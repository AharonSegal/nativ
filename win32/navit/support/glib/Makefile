	cd /workspaces/nativ/win32 && $(MAKE) $(MAKESILENT) -f navit/support/glib/CMakeFiles/support_glib.dir/build.make navit/support/glib/CMakeFiles/support_glib.dir/gstring.c.s
.PHONY : gstring.c.s

